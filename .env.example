# -----------------------
# Postgres (primary data)
# -----------------------
POSTGRE_DB=yaya
POSTGRE_USER=postgres
POSTGRE_PW=postgres
POSTGRE_HOST=localhost
POSTGRE_WRITE_PORT=5432

# -----------------------
# gRPC (DB Writes)
# -----------------------
# Server bind address (used by `microservices/db_writes/db_writes.py`)
GRPC_INSC_PORT=0.0.0.0:50051
# Client channel target (used by `microservices/main.py`)
GRPC_INSC_CHANNEL=localhost:50051

# -----------------------
# Internal service URLs
# -----------------------
DB_READER_SERVICE_URL=http://localhost:8001
RECOMMENDATION_SERVICE_URL=http://localhost:8002

# -----------------------
# JWT auth
# -----------------------
JWT_ALGORITHM=HS256
SECRET_KEYS_CURRENT=change-me
SECRET_KEYS_PREVIOUS=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------
# Redis (TLS/SSL by default)
# -----------------------
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# -----------------------
# RabbitMQ / Celery
# -----------------------
CELERY_BROKER_URL=pyamqp://guest:guest@localhost:5672//
